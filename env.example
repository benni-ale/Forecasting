# Alpha Vantage API Key
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Copy this file to .env and replace 'your_api_key_here' with your actual API key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Alpha Vantage Rate Limit (calls per minute)
# Free tier: 5 calls/minute
# Premium tier: 75 calls/minute (default)
ALPHA_VANTAGE_RATE_LIMIT=75

# PostgreSQL Database Configuration
POSTGRES_DB=newsdb
POSTGRES_USER=newsuser
POSTGRES_PASSWORD=newspass
POSTGRES_PORT=5432

# Flask Web Application
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-this-in-production

